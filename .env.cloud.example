# Container image published by CI/CD. Keep the local default when building on the server.
SP2026_API_IMAGE=summer-project-2026-backend:local

# Database
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
SP2026_DB_USERNAME=summer_project
SP2026_DB_PASSWORD=replace-with-a-strong-database-password
SP2026_DB_NAME=summer_project_2026

# LLM (DashScope / OpenAI compatible)
SP2026_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SP2026_LLM_API_KEY=replace-with-your-llm-api-key
SP2026_LLM_MODEL_NAME=qwen3-vl-flash

# Embedding (RAG)
SP2026_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SP2026_EMBEDDING_API_KEY=replace-with-your-embedding-api-key
SP2026_EMBEDDING_MODEL_NAME=text-embedding-v4
SP2026_EMBEDDING_DIMENSIONS=1024
SP2026_EMBEDDING_CONCURRENCY=10
SP2026_EMBEDDING_TIMEOUT=60

# 30-channel RTSP / YOLO pipeline
SP2026_ENABLE_STREAMING=true
SP2026_STREAM_FPS=15
SP2026_RTSP_OPEN_TIMEOUT_MS=5000
SP2026_RTSP_READ_TIMEOUT_MS=5000
SP2026_RTSP_CONNECT_CONCURRENCY=4
SP2026_RTSP_RECONNECT_DELAY=1
SP2026_RTSP_MAX_RECONNECT_DELAY=30
SP2026_RTSP_STARTUP_SPREAD_SECONDS=2
SP2026_RTSP_STALE_FRAME_SECONDS=6
SP2026_PROCESSED_STALE_FRAME_SECONDS=8
SP2026_RTSP_HW_ACCELERATION=false
SP2026_DETECT_RESIZE_WIDTH=0

# RTX 4060 / 8 CPU threads baseline
SP2026_YOLO_BATCH_SIZE=8
SP2026_YOLO_POST_WORKERS=8
SP2026_OPENCV_THREADS=1
SP2026_YOLO_BATCH_COLLECT_MS=8
SP2026_YOLO_IMAGE_SIZE=640
SP2026_YOLO_HALF=true
